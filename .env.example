# Copy this file to .env and adjust it for your Lyrarma Cloud server.
CLOUD_API_URL=https://cloud.example.com
CLOUD_PUBLIC_URL=https://cloud.example.com

# These values are optional. The desktop login screen can obtain a token.
CLOUD_API_TOKEN=
CLOUD_USERNAME=

# Leave the directory empty to use ~/lyrarma-cloud.
CLOUD_SYNC_DIR=
CLOUD_SYNC_INTERVAL=15
APP_LANGUAGE=en

# Timeouts are expressed in seconds.
CLOUD_CONNECT_TIMEOUT=30
CLOUD_TRANSFER_TIMEOUT=300
